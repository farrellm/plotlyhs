cabal-version:      3.14
name:               plotlyhs
version:            0.2.2
synopsis:           Haskell bindings to Plotly.js
description:
  Generate web-based plots with the Plotly.js library.
  For examples, see <https://farrellm.github.io/plotlyhs/>

license:            MIT
license-file:       LICENSE
author:             Tom Nielsen
maintainer:         farrellm@alum.mit.edu
homepage:           https://github.com/farrellm/plotlyhs
bug-reports:        https://github.com/farrellm/plotlyhs/issues
category:           Graphics, Charts
build-type:         Simple
tested-with:        GHC ==9.12.4
extra-doc-files:
  changelog.md
  README.md

extra-source-files:
  vendor/plotly.js/plotly.min.js
  vendor/plotly.py/templates/*.json

source-repository head
  type:     git
  location: https://github.com/farrellm/plotlyhs.git

-- CI adds -Werror from the command line.
common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

library
  import:           warnings
  default-language: GHC2024
  hs-source-dirs:   src src-gen
  exposed-modules:
    Graphics.Plotly
    Graphics.Plotly.Colors
    Graphics.Plotly.Core
    Graphics.Plotly.Figure
    Graphics.Plotly.Grid
    Graphics.Plotly.Html
    Graphics.Plotly.Image
    Graphics.Plotly.Json
    Graphics.Plotly.Subplots
    Graphics.Plotly.Template
    Graphics.Plotly.Types
    -- BEGIN GENERATED MODULES
    Graphics.Plotly.Animation
    Graphics.Plotly.Colors.Cyclical
    Graphics.Plotly.Colors.Diverging
    Graphics.Plotly.Colors.Qualitative
    Graphics.Plotly.Colors.Sequential
    Graphics.Plotly.Config
    Graphics.Plotly.Enums
    Graphics.Plotly.Frame
    Graphics.Plotly.Layout
    Graphics.Plotly.Layout.Annotations
    Graphics.Plotly.Layout.Coloraxis
    Graphics.Plotly.Layout.Geo
    Graphics.Plotly.Layout.Legend
    Graphics.Plotly.Layout.Map
    Graphics.Plotly.Layout.Newshape
    Graphics.Plotly.Layout.Polar
    Graphics.Plotly.Layout.Scene
    Graphics.Plotly.Layout.Shapes
    Graphics.Plotly.Layout.Sliders
    Graphics.Plotly.Layout.Smith
    Graphics.Plotly.Layout.Ternary
    Graphics.Plotly.Layout.Title
    Graphics.Plotly.Layout.Updatemenus
    Graphics.Plotly.Layout.Xaxis
    Graphics.Plotly.Layout.Yaxis
    Graphics.Plotly.SubplotKind
    Graphics.Plotly.Template.Builtin
    Graphics.Plotly.Trace.Bar
    Graphics.Plotly.Trace.Barpolar
    Graphics.Plotly.Trace.Box
    Graphics.Plotly.Trace.Candlestick
    Graphics.Plotly.Trace.Carpet
    Graphics.Plotly.Trace.Choropleth
    Graphics.Plotly.Trace.Choroplethmap
    Graphics.Plotly.Trace.Cone
    Graphics.Plotly.Trace.Contour
    Graphics.Plotly.Trace.Contourcarpet
    Graphics.Plotly.Trace.Densitymap
    Graphics.Plotly.Trace.Funnel
    Graphics.Plotly.Trace.Funnelarea
    Graphics.Plotly.Trace.Heatmap
    Graphics.Plotly.Trace.Histogram
    Graphics.Plotly.Trace.Histogram2d
    Graphics.Plotly.Trace.Histogram2dcontour
    Graphics.Plotly.Trace.Icicle
    Graphics.Plotly.Trace.Image
    Graphics.Plotly.Trace.Indicator
    Graphics.Plotly.Trace.Isosurface
    Graphics.Plotly.Trace.Mesh3d
    Graphics.Plotly.Trace.Ohlc
    Graphics.Plotly.Trace.Parcats
    Graphics.Plotly.Trace.Parcoords
    Graphics.Plotly.Trace.Pie
    Graphics.Plotly.Trace.Quiver
    Graphics.Plotly.Trace.Sankey
    Graphics.Plotly.Trace.Scatter
    Graphics.Plotly.Trace.Scatter3d
    Graphics.Plotly.Trace.Scattercarpet
    Graphics.Plotly.Trace.Scattergeo
    Graphics.Plotly.Trace.Scattergl
    Graphics.Plotly.Trace.Scattermap
    Graphics.Plotly.Trace.Scatterpolar
    Graphics.Plotly.Trace.Scatterpolargl
    Graphics.Plotly.Trace.Scattersmith
    Graphics.Plotly.Trace.Scatterternary
    Graphics.Plotly.Trace.Splom
    Graphics.Plotly.Trace.Streamtube
    Graphics.Plotly.Trace.Sunburst
    Graphics.Plotly.Trace.Surface
    Graphics.Plotly.Trace.Table
    Graphics.Plotly.Trace.Treemap
    Graphics.Plotly.Trace.Violin
    Graphics.Plotly.Trace.Volume
    Graphics.Plotly.Trace.Waterfall
    Graphics.Plotly.TraceType
    Graphics.Plotly.Traces
    Graphics.Plotly.Version
    -- END GENERATED MODULES

  other-modules:
    Graphics.Plotly.Internal.Bundle
    Graphics.Plotly.Internal.Core
    Graphics.Plotly.Internal.Embed

  build-depends:
    , aeson              ^>=2.3
    , base               ^>=4.21.2.0
    , base64-bytestring  ^>=1.2.1
    , bytestring         ^>=0.12.2
    , containers         ^>=0.7
    , directory          ^>=1.3.8
    , file-embed         ^>=0.0.16
    , filepath           ^>=1.5.2
    , optics-core        ^>=0.4.1
    , process            ^>=1.6.19
    , scientific         ^>=0.3.8
    , template-haskell   ^>=2.23
    , temporary          ^>=1.3
    , text               ^>=2.1
    , time               ^>=1.14
    , vector             ^>=0.13.2

  if !os(windows)
    build-depends: unix ^>=2.8

-- Render figures with lucid: depend on plotlyhs:lucid.
library lucid
  import:           warnings
  visibility:       public
  default-language: GHC2024
  hs-source-dirs:   src-lucid
  exposed-modules:  Graphics.Plotly.Lucid
  build-depends:
    , base
    , lucid     ^>=2.11
    , plotlyhs
    , text

-- Render figures with blaze-html: depend on plotlyhs:blaze.
library blaze
  import:           warnings
  visibility:       public
  default-language: GHC2024
  hs-source-dirs:   src-blaze
  exposed-modules:  Graphics.Plotly.Blaze
  build-depends:
    , base
    , blaze-html  ^>=0.9.2
    , plotlyhs
    , text

test-suite golden
  import:           warnings
  default-language: GHC2024
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    FigureTests
    TypeErrors

  build-depends:
    , aeson
    , aeson-pretty  ^>=0.8.10
    , base
    , blaze-html
    , bytestring
    , directory
    , lucid
    , optics-core
    , plotlyhs
    , plotlyhs:blaze
    , plotlyhs:lucid
    , tasty         ^>=1.5
    , tasty-golden  ^>=2.3.5
    , tasty-hunit   ^>=0.10.2
    , text
