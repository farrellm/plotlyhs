cabal-version:      3.14
name:               plotlyhs
version:            0.2.2
synopsis:           Haskell bindings to Plotly.js
description:
  Generate web-based plots with the Plotly.js library.
  For examples, see <https://farrellm.github.io/plotlyhs/>

license:            MIT
license-file:       LICENSE
author:             Tom Nielsen
maintainer:         farrellm@alum.mit.edu
homepage:           https://github.com/farrellm/plotlyhs
bug-reports:        https://github.com/farrellm/plotlyhs/issues
category:           Graphics, Charts
build-type:         Simple
tested-with:        GHC ==9.12.4
extra-doc-files:
  changelog.md
  README.md

source-repository head
  type:     git
  location: https://github.com/farrellm/plotlyhs.git

-- CI adds -Werror from the command line. No -Wredundant-constraints: GoG's
-- setters carry AxisValue/IsColor constraints they don't use, as API guardrails.
common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wno-type-defaults

library
  import:           warnings
  default-language: GHC2024
  hs-source-dirs:   src
  exposed-modules:
    Graphics.Plotly
    Graphics.Plotly.Base
    Graphics.Plotly.Blaze
    Graphics.Plotly.GoG
    Graphics.Plotly.Histogram
    Graphics.Plotly.Lucid
    Graphics.Plotly.Simple
    Graphics.Plotly.Utils

  build-depends:
    , aeson         ^>=2.3
    , base          ^>=4.21.2.0
    , blaze-html    ^>=0.9.2
    , blaze-markup  ^>=0.8.3
    , bytestring    ^>=0.12.2
    , lucid         ^>=2.11
    , microlens     ^>=0.5
    , microlens-th  ^>=0.4.3
    , text          ^>=2.1
    , time          ^>=1.14

test-suite golden
  import:           warnings
  default-language: GHC2024
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
    , aeson
    , aeson-pretty  ^>=0.8.10
    , base
    , blaze-html
    , bytestring
    , lucid
    , microlens
    , plotlyhs
    , tasty         ^>=1.5
    , tasty-golden  ^>=2.3.5
    , text
