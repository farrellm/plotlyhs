cabal-version:      3.14
name:               plotlyhs-jupyter
version:            0.1.0
synopsis:           Jupyter display support for plotlyhs
description:
  Displays plotlyhs figures in Jupyter notebooks running the IHaskell
  kernel, as HTML that draws them with plotly.js.

license:            MIT
license-file:       LICENSE
author:             Matthew Farrell
maintainer:         farrellm@alum.mit.edu
homepage:           https://github.com/farrellm/plotlyhs
bug-reports:        https://github.com/farrellm/plotlyhs/issues
category:           Graphics, Charts, Jupyter
build-type:         Simple
tested-with:        GHC ==9.12.4

source-repository head
  type:     git
  location: https://github.com/farrellm/plotlyhs.git
  subdir:   plotlyhs-jupyter

common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

library
  import:           warnings
  default-language: GHC2024
  hs-source-dirs:   src
  exposed-modules:  Graphics.Plotly.Jupyter
  build-depends:
    , base         ^>=4.21.2.0
    , ihaskell     ^>=0.13
    , optics-core  ^>=0.4.1
    , plotlyhs     ^>=0.2.2
    , text         ^>=2.1
    , time         ^>=1.14

test-suite display
  import:           warnings
  default-language: GHC2024
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
    , base
    , ihaskell
    , ipython-kernel    ^>=0.12
    , plotlyhs
    , plotlyhs-jupyter
    , tasty             ^>=1.5
    , tasty-hunit       ^>=0.10.2
    , text
